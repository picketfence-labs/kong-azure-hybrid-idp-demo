# docker compose用の環境変数。コピーして .env を作成する（.envはコミット対象外）。
#   cp .env.example .env

# Kong Gateway自身のPostgres接続パスワード（ローカル検証用の任意の値でよい）
KONG_PG_PASSWORD=

# Kong Enterpriseライセンス（JSON文字列、または `deck` 同様1行で貼り付け）
KONG_LICENSE_DATA=

# ADFS VM（vm-adfs-demo）のPublic IP。`terraform output adfs_vm_public_ip`で取得する。
# KongコンテナからADFSの名前解決を通すためのextra_hostsに使う（docs/adfs-setup-runbook.md Section 2参照）。
# VM再作成でIPが変わった場合はここも更新する。
ADFS_PUBLIC_IP=

# ADFSのApplication Group登録（scripts/adfs/Register-KongDemoApplication.ps1）で払い出される値。
# docs/adfs-setup-runbook.md Section 3参照。DECK_ADFS_CLIENT_SECRET以外は非秘密の固定値。
DECK_ADFS_ISSUER=https://adfs.adfsdemo.picketfencelabs.local/adfs
DECK_ADFS_CLIENT_ID=5923191c-da9f-4c23-ac6f-dd7be8b5b93a
DECK_ADFS_RESOURCE=urn:kong:insurance-api
DECK_ADFS_GROUP_CLAIM_NAME=https://picketfencelabs.local/claims/department

# ADFSのServer application（confidential client）のclient secret。
# RDPで.\Register-KongDemoApplication.ps1 -Applyを実行した際にクリップボードへ置かれる値を
# 直接ペーストする。チャット・コマンド引数・PR・コミットには絶対に含めない。
DECK_ADFS_CLIENT_SECRET=

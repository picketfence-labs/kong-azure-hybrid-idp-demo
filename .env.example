# docker compose用の環境変数。コピーして .env を作成する（.envはコミット対象外）。
#   cp .env.example .env

# Kong Gateway自身のPostgres接続パスワード（ローカル検証用の任意の値でよい）
KONG_PG_PASSWORD=

# Kong Enterpriseライセンス（JSON文字列、または `deck` 同様1行で貼り付け）
KONG_LICENSE_DATA=

# ADFS VM（vm-adfs-demo）のPublic IP。`terraform output adfs_vm_public_ip`で取得する。
# KongコンテナからADFSの名前解決を通すためのextra_hostsに使う（docs/adfs-setup-runbook.md Section 2参照）。
# VM再作成でIPが変わった場合はここも更新する。
ADFS_PUBLIC_IP=
